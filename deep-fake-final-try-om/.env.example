# Copy to .env to override. Defaults work as-is for `docker compose up --build`.

# --- Model ---
MODEL_ID=buildborderless/CommunityForensics-DeepfakeDet-ViT
# Pin an exact model commit hash for reproducible builds (leave as "main" to track latest)
MODEL_REVISION=main
# 0 = let torch pick; set to a specific core count to cap CPU usage
TORCH_NUM_THREADS=0

# --- Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=3100

# --- CORS (comma-separated origins allowed to call the backend directly) ---
# Only matters for calling the backend from somewhere other than the bundled frontend
# (e.g. `npm run dev`, which runs Vite on :5173, is already included by default).
# ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:5173

# --- Upload limits ---
MAX_IMAGE_MB=20
MAX_VIDEO_MB=200

# --- Video sampling ---
VIDEO_SAMPLE_INTERVAL_SECONDS=1.0
VIDEO_MAX_DURATION_SECONDS=120
VIDEO_MAX_FRAMES=60

# --- Decision thresholds ---
# Not read from here by default (see backend/app/thresholds.json for the checked-in
# policy and rationale). To override at runtime, uncomment both AND add them under
# `backend.environment` in docker-compose.yml, since compose only auto-injects variables
# that are explicitly listed there.
# FAKE_THRESHOLD=0.6
# REAL_THRESHOLD=0.4
